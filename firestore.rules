rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidAccount(data) {
      return data.keys().hasAll(['id', 'companyName', 'ownerId', 'industry', 'status']) &&
             data.keys().size() == 5 &&
             data.id is string && data.id.size() <= 128 &&
             data.companyName is string && data.companyName.size() <= 200 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.industry is string && data.industry.size() <= 200 &&
             data.status is string && data.status.size() <= 50;
    }
    
    match /accounts/{accountId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(accountId) && isValidAccount(incoming());
      allow update: if isSignedIn() && isValidId(accountId) && isValidAccount(incoming()) && incoming().ownerId == existing().ownerId && incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['companyName', 'industry', 'status']);
      allow delete: if false;
    }
    
    function isValidContact(data) {
       return data.keys().hasAll(['id', 'accountId', 'name', 'designation', 'email', 'phone']) &&
              data.keys().size() == 6 &&
              data.id is string && data.id.size() <= 128 &&
              data.accountId is string && data.accountId.size() <= 128 &&
              data.name is string && data.name.size() <= 200 &&
              data.designation is string && data.designation.size() <= 200 &&
              data.email is string && data.email.size() <= 255 &&
              data.phone is string && data.phone.size() <= 50;
    }
    
    match /contacts/{contactId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(contactId) && isValidContact(incoming()) && exists(/databases/$(database)/documents/accounts/$(incoming().accountId));
      allow update: if isSignedIn() && isValidId(contactId) && isValidContact(incoming()) && incoming().accountId == existing().accountId && incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'designation', 'email', 'phone']);
      allow delete: if false;
    }

    function isValidVendor(data) {
       return data.keys().hasAll(['id', 'companyName', 'tier', 'responseRate', 'performanceScore']) &&
              data.keys().size() == 5 &&
              data.id is string && data.id.size() <= 128 &&
              data.companyName is string && data.companyName.size() <= 200 &&
              data.tier is string && data.tier.size() <= 50 &&
              data.responseRate is number && data.responseRate >= 0 && data.responseRate <= 100 &&
              data.performanceScore is number && data.performanceScore >= 0 && data.performanceScore <= 100;
    }

    match /vendors/{vendorId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(vendorId) && isValidVendor(incoming());
      allow update: if isSignedIn() && isValidId(vendorId) && isValidVendor(incoming()) && incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['companyName', 'tier', 'responseRate', 'performanceScore']);
      allow delete: if false;
    }
    
    function isValidRequirement(data) {
       return data.keys().hasAll(['id', 'accountId', 'title', 'status', 'priority']) &&
              data.keys().size() == 5 &&
              data.id is string && data.id.size() <= 128 &&
              data.accountId is string && data.accountId.size() <= 128 &&
              data.title is string && data.title.size() <= 200 &&
              data.status is string && data.status.size() <= 50 &&
              data.priority is string && data.priority.size() <= 50;
    }

    match /requirements/{requirementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(requirementId) && isValidRequirement(incoming()) && exists(/databases/$(database)/documents/accounts/$(incoming().accountId));
      allow update: if isSignedIn() && isValidId(requirementId) && isValidRequirement(incoming()) && incoming().accountId == existing().accountId && incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'status', 'priority']);
      allow delete: if false;
    }
    
    function isValidSystemEvent(data) {
       return data.keys().hasAll(['id', 'eventType', 'entityType', 'entityId', 'actorId', 'timestamp']) &&
              data.keys().size() == 6 &&
              data.id is string && data.id.size() <= 128 &&
              data.eventType is string && data.eventType.size() <= 128 &&
              data.entityType is string && data.entityType.size() <= 128 &&
              data.entityId is string && data.entityId.size() <= 128 &&
              data.actorId is string && data.actorId.size() <= 128 &&
              data.timestamp is string && data.timestamp.size() <= 128;
    }

    match /system_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(eventId) && isValidSystemEvent(incoming());
      allow update: if false;
      allow delete: if false;
    }

    function isValidCommunication(data) {
       return data.keys().hasAll(['id', 'entityId', 'entityType', 'channel', 'direction', 'content', 'timestamp']) &&
              data.keys().size() == 7 &&
              data.id is string && data.id.size() <= 128 &&
              data.entityId is string && data.entityId.size() <= 128 &&
              data.entityType is string && data.entityType.size() <= 50 &&
              data.channel is string && data.channel.size() <= 50 &&
              data.direction is string && data.direction.size() <= 50 &&
              data.content is string && data.content.size() <= 10000 &&
              data.timestamp is string && data.timestamp.size() <= 128;
    }

    match /communications/{commId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(commId) && isValidCommunication(incoming());
      allow update: if false;
      allow delete: if false;
    }

    function isValidRevenuePipeline(data) {
       return data.keys().hasAll(['id', 'requirementId', 'accountId', 'stage', 'expectedAmount', 'probability']) &&
              data.keys().size() == 6 &&
              data.id is string && data.id.size() <= 128 &&
              data.requirementId is string && data.requirementId.size() <= 128 &&
              data.accountId is string && data.accountId.size() <= 128 &&
              data.stage is string && data.stage.size() <= 50 &&
              data.expectedAmount is number &&
              data.probability is number && data.probability >= 0 && data.probability <= 100;
    }

    match /revenue_pipeline/{pipelineId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(pipelineId) && isValidRevenuePipeline(incoming());
      allow update: if isSignedIn() && isValidId(pipelineId) && isValidRevenuePipeline(incoming()) && incoming().id == existing().id &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'expectedAmount', 'probability']);
      allow delete: if false;
    }
    
    function isValidUser(data) {
        return data.keys().hasAll(['id', 'email', 'role']) &&
               data.keys().size() == 3 &&
               data.id is string && data.id.size() <= 128 &&
               data.email is string && data.email.size() <= 255 &&
               data.role is string && data.role.size() <= 50;
    }
    
    match /users/{userId} {
      allow read: if isSignedIn();
      // Only the authenticated user can create their profile. Or Admin. Not defining self-escalation perfectly here but locking role updates.
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && incoming().id == request.auth.uid;
      // Users cannot change their own roles - requires admin intervention usually, but restricting fields for now.
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && incoming().id == existing().id && incoming().role == existing().role &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email']);
      allow delete: if false;
    }

    function isValidMigrationMetrics(data) {
        return data.keys().hasAll(['id', 'timestamp', 'collectionName', 'supabaseCount', 'firebaseCount', 'parity', 'fieldParity', 'relationshipParity', 'eventParity', 'status']) &&
               data.keys().size() == 10 &&
               data.id is string && data.id.size() <= 128 &&
               data.timestamp is string && data.timestamp.size() <= 128 &&
               data.collectionName is string && data.collectionName.size() <= 128 &&
               data.supabaseCount is number &&
               data.firebaseCount is number &&
               data.parity is number &&
               data.fieldParity is number &&
               data.relationshipParity is number &&
               data.eventParity is number &&
               data.status is string && data.status.size() <= 50;
    }

    match /migration_metrics/{metricId} {
      // Only founders/admins should ideally read this, but for now we restrict to signed in
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(metricId) && isValidMigrationMetrics(incoming());
      allow update: if false;
      allow delete: if false;
    }

    match /gmail_connections/{connId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn(); // Basic rules for now, to be locked down later
      allow delete: if false;
    }

    match /gmail_messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false; // immutable emails
      allow delete: if false;
    }

    match /email_threads/{threadId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /email_attachments/{attachId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false; 
      allow delete: if false;
    }

    match /email_entity_links/{linkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false; // Immutable audit trail
      allow delete: if false;
    }

    match /agent_activities/{id} {
      allow read, write: if isSignedIn();
    }

    match /activity_ledger/{id} {
      allow read, write: if isSignedIn();
    }

    match /submission_ledger/{id} {
      allow read, write: if isSignedIn();
    }

    match /vendor_broadcasts/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /vendor_responses/{id} {
      allow read, write: if isSignedIn();
    }

    match /jobs/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /candidates/{id} {
      allow read, write: if isSignedIn();
    }

    match /candidateOwnership/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
